<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- The native launch splash: the launcher icon (on Android 12+ the
         activity-alias's, so it matches the themed icon) on a plain background
         from the very first frame. MainActivity keeps it up until JS has drawn
         (LaunchSplashModule.kt), then switches to AppTheme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A short tick on long-press and reactions (src/haptics.ts). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- What only the sideloaded build has (the background connection for
         notifications, the in-app updater) is in src/sideload/AndroidManifest.xml;
         the Google Play build adds just the voice service type, in
         src/play/AndroidManifest.xml. -->
    <!-- Voice rooms (src/call/): the microphone, audio routing (speaker,
         earpiece, Bluetooth headsets), and a microphone-type foreground
         service so voice keeps going with the app in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher_dark"
      android:roundIcon="@mipmap/ic_launcher_dark_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false">
      <!-- enableOnBackInvokedCallback=false: Android 16 (API 36) turns on
           predictive back by default, which skips the app's own back handling
           (BackHandler in App.tsx, Overlay.tsx, OnboardingScreen.tsx). -->

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Invite links. The https one opens straight into the app once the
             server serves /.well-known/assetlinks.json with this app's signing
             key (SUPERCHAT_ANDROID_CERT_SHA256); otherwise the browser shows
             the server's landing page, which hands off via superchat://. -->
        <intent-filter android:autoVerify="true">
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <category android:name="android.intent.category.BROWSABLE" />
          <data android:scheme="https" android:host="chat.superbadger.io" android:pathPrefix="/i/" />
        </intent-filter>
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <category android:name="android.intent.category.BROWSABLE" />
          <data android:scheme="superchat" android:host="join" />
        </intent-filter>
      </activity>

      <!-- The launcher entries. MainActivity is no longer launchable by itself;
           instead there is one alias per app theme, each with that theme's
           icon, and exactly one is enabled at a time (light by default).
           AppIconModule.kt enables the one matching the current theme when the
           app goes to the background — see src/appIcon.ts. The icons are
           generated by tools/appart from the same art as the splash. -->
      <activity-alias
        android:name=".IconLight"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_light"
        android:roundIcon="@mipmap/ic_launcher_light_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconDark"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_dark"
        android:roundIcon="@mipmap/ic_launcher_dark_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconSlate"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_slate"
        android:roundIcon="@mipmap/ic_launcher_slate_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconSepia"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sepia"
        android:roundIcon="@mipmap/ic_launcher_sepia_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconEmber"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ember"
        android:roundIcon="@mipmap/ic_launcher_ember_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
    </application>
</manifest>

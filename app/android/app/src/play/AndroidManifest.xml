<!-- The Google Play build: merged over src/main/AndroidManifest.xml. No
     always-on background connection and no in-app updater (Play doesn't
     allow either): notifications come through FCM. Voice's foreground
     service (VoiceCallService) is in src/main. Notifee's own service is
     never started in this build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
      <!-- Wake-ups from the chat server through FCM (server/push). -->
      <service
        android:name=".SuperChatMessagingService"
        android:exported="false">
        <intent-filter>
          <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>
    </application>
</manifest>

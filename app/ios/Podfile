# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# The old architecture, like Android (newArchEnabled=false in
# android/gradle.properties): the app's native libraries are on it.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SuperchatApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Firebase Cloud Messaging, for push (SuperchatApp/PushModule.m): the
  # same FCM topics as the Google Play build, delivered through APNs.
  # Firebase's Swift pods need modular headers from the pods they use,
  # since the app links pods statically rather than as frameworks.
  pod 'FirebaseCore', '~> 11.0', :modular_headers => true
  pod 'FirebaseCoreInternal', '~> 11.0', :modular_headers => true
  pod 'FirebaseMessaging', '~> 11.0', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 (pinned by React Native 0.81) doesn't compile under Xcode
    # 26's clang in C++20: its FMT_STRING checks are rejected as consteval
    # errors. As C++17 it skips consteval; nothing else about it changes.
    # Drop this once React Native ships a newer fmt.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end

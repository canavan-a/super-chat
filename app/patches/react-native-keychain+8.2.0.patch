+  private static boolean needsUserAuth(Throwable t) {
+    for (Throwable c = t; c != null; c = c.getCause()) {
+      if (c instanceof UserNotAuthenticatedException) return true;
+      if (c instanceof javax.crypto.IllegalBlockSizeException) return true;
+      final String m = c.getMessage();
+      if (m != null && m.toLowerCase(java.util.Locale.ROOT).contains("not authenticated")) return true;
+      if (c.getCause() == c) break;
+    }
+    return false;
+  }
